// demo.sipl: Prism3D milestone 1 scene. Builds the scene, then runs once per frame.
// Arrow keys move the sphere, Escape quits.
add prism.def
add demo.def

func main [
    prism.clear = 0x1A1F2A
    prism.ambient = 0x202028

    prism.camera = 1            // camera, made active
    prism.py = 2500
    prism.pz = 7000
    prism.rx = -18000           // tilt down 18 degrees

    prism.light = 0             // warm sun
    prism.rx = -55000
    prism.ry = 35000
    prism.color = 0xFFEED8

    prism.light = 1             // blue point light
    prism.px = -2500
    prism.py = 1200
    prism.pz = 1000
    prism.color = 0x3070FF
    prism.range = 9000

    prism.spawn = 3             // floor
    prism.sx = 14000
    prism.sz = 14000
    prism.py = -1000
    prism.tex = 1
    prism.color = 0xB0B0B8

    prism.spawn = 1             // cube
    cube = prism.sel
    prism.px = -1300
    prism.color = 0xFF7A40
    prism.tex = 1

    prism.spawn = 2             // sphere
    ball = prism.sel
    bx = 1300
    prism.px = bx
    prism.sx = 1300
    prism.sy = 1300
    prism.sz = 1300
    prism.color = 0x60E090

    prism.log = "scene ready"

    def frame (id 1)
    t = prism.ms
    prism.sel = cube
    k = t * 90                  // 90 degrees per second, in thousandths of a degree
    prism.ry = k
    k = t * 35
    prism.rx = k

    k = prism.dt * 3            // 3 units per second
    if prism.keys(79) = 1 [
        bx + k
    ]
    if prism.keys(80) = 1 [
        bx - k
    ]
    if prism.keys(81) = 1 [
        bz + k
    ]
    if prism.keys(82) = 1 [
        bz - k
    ]
    prism.sel = ball
    prism.px = bx
    prism.pz = bz

    prism.frame = 1
    if prism.quit = 1 [
        kill 0
    ]
    if prism.keys(41) = 1 [
        kill 0
    ]
    jump (id 1)
]
